    },
    {
      "name": "ctx_shared_packages",
      "group": "G3",
      "type": "integer",
      "unit": "count",
      "description": "Candidate packages the app already ships"
    },
    {
      "name": "ctx_shared_bytes_saved",
      "group": "G3",
      "type": "number",
      "unit": "bytes",
