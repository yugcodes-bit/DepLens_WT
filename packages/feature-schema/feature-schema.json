{
  "$comment": "Single source of truth for DepLens feature names (docs/08 §3). Bump schemaVersion on any change. G6 features are allowed only in the hybrid model.",
  "schemaVersion": 1,
  "groups": {
    "G1": "package metadata",
    "G2": "isolated bundle",
    "G3": "in-context delta",
    "G4": "code structure of added code",
    "G5": "host context",
    "G6": "measured (hybrid only)",
    "G7": "profile"
  },
  "targets": [
    {
      "name": "delta_script_ms",
      "description": "ΔScript: Δ(compile+eval+gc) main-thread thread-time in the load window, HL estimate of paired diffs",
      "primary": true
    },
    {
      "name": "delta_tbt_ms",
      "description": "ΔTBT_load",
      "primary": false
    }
  ],
  "features": [
    {
      "name": "pkg_unpacked_bytes",
      "group": "G1",
      "type": "number",
      "unit": "bytes",
      "description": "Unpacked tarball size",
      "monotone": 1
    },
    {
      "name": "pkg_js_files",
      "group": "G1",
      "type": "integer",
      "unit": "count",
      "description": "Number of .js/.mjs/.cjs files in the tarball"
    },
    {
      "name": "pkg_format",
      "group": "G1",
      "type": "category",
      "unit": null,
      "description": "Module format of the resolved entry",
      "values": [
        "esm",
        "cjs",
        "dual",
        "umd"
      ]
    },
    {
      "name": "pkg_has_exports_map",
      "group": "G1",
      "type": "boolean",
      "unit": null,
      "description": "package.json has an exports field"
    },
    {
      "name": "pkg_sideeffects",
      "group": "G1",
      "type": "category",
      "unit": null,
      "description": "sideEffects declaration",
      "values": [
        "false",
        "array",
        "absent",
        "true"
      ]
    },
    {
      "name": "pkg_n_deps",
      "group": "G1",
      "type": "integer",
      "unit": "count",
      "description": "Direct dependencies"
    },
    {
      "name": "pkg_n_peer_deps",
      "group": "G1",
      "type": "integer",
      "unit": "count",
      "description": "Peer dependencies"
    },
    {
      "name": "pkg_n_transitive",
      "group": "G1",
      "type": "integer",
      "unit": "count",
      "description": "Transitive runtime dependencies"
    },
    {
      "name": "pkg_has_wasm",
      "group": "G1",
      "type": "boolean",
      "unit": null,
      "description": "Tarball contains .wasm files"
    },
    {
      "name": "pkg_has_worker",
      "group": "G1",
      "type": "boolean",
      "unit": null,
      "description": "Package spawns or ships web workers"
    },
    {
      "name": "pkg_ships_minified",
      "group": "G1",
      "type": "boolean",
      "unit": null,
      "description": "Resolved entry appears pre-bundled/minified"
    },
    {
      "name": "iso_min_bytes",
      "group": "G2",
      "type": "number",
      "unit": "bytes",
      "description": "Minified bytes of the import spec bundled alone (peers external)",
      "monotone": 1
    },
    {
      "name": "iso_gz_bytes",
      "group": "G2",
      "type": "number",
      "unit": "bytes",
      "description": "gzip-9 bytes of the isolated bundle",
      "monotone": 1
    },
    {
      "name": "iso_br_bytes",
      "group": "G2",
      "type": "number",
      "unit": "bytes",
      "description": "brotli-11 bytes of the isolated bundle",
      "monotone": 1
    },
    {
      "name": "iso_full_min_bytes",
      "group": "G2",
      "type": "number",
      "unit": "bytes",
      "description": "Minified bytes of the full namespace import (Bundlephobia-style)",
      "monotone": 1
    },
    {
      "name": "iso_treeshake_ratio",
      "group": "G2",
      "type": "number",
      "unit": "ratio",
      "description": "iso_min_bytes / iso_full_min_bytes"
    },
    {
      "name": "iso_modules",
      "group": "G2",
      "type": "integer",
      "unit": "count",
      "description": "Modules in the isolated bundle"
    },
    {
      "name": "iso_packages",
      "group": "G2",
      "type": "integer",
      "unit": "count",
      "description": "Distinct packages in the isolated bundle"
    },
    {
      "name": "iso_cjs_byte_share",
      "group": "G2",
      "type": "number",
      "unit": "ratio",
      "description": "Share of isolated bytes coming from CommonJS modules"
    },
    {
      "name": "ctx_delta_min_bytes",
      "group": "G3",
      "type": "number",
      "unit": "bytes",
      "description": "Exact Δ minified bytes of the initial load (treatment − baseline)",
      "monotone": 1
    },
    {
      "name": "ctx_delta_gz_bytes",
      "group": "G3",
      "type": "number",
      "unit": "bytes",
      "description": "Exact Δ gzip bytes of the initial load",
      "monotone": 1
    },
    {
      "name": "ctx_delta_br_bytes",
      "group": "G3",
      "type": "number",
      "unit": "bytes",
      "description": "Exact Δ brotli bytes of the initial load",
      "monotone": 1
    },
    {
      "name": "ctx_delta_modules",
      "group": "G3",
      "type": "integer",
      "unit": "count",
      "description": "Modules added to the initial load"
    },
    {
      "name": "ctx_new_packages",
      "group": "G3",
      "type": "integer",
      "unit": "count",
