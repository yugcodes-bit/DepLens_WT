{
  "name": "deplens",
  "private": true,
  "version": "0.1.0",
  "description": "Context-aware prediction of the browser runtime cost of npm dependencies",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm --filter @deplens/harness test",
    "typecheck": "pnpm -r typecheck",
    "harness": "tsx packages/harness/src/cli.ts",
    "hosts": "tsx packages/harness/src/cli.ts hosts",
    "fixtures": "node research/fixtures/generate.mjs",
    "phase0": "tsx research/experiments/phase0.ts",
    "db:serve": "pnpm --filter @deplens/db serve",
    "db:migrate": "pnpm --filter @deplens/db migrate:local",
    "web": "pnpm --filter @deplens/web dev",
    "test:web": "pnpm --filter @deplens/web test:e2e"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
