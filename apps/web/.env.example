# ---------------------------------------------------------------- database (required)
# Local development: run `pnpm db:serve` in another terminal (PGlite behind a Postgres socket,
# nothing to install) and use the URL below unchanged.
# Production: the Neon pooled connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- secrets (required)
# Signs CAPTCHA challenges and hashes session ids. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-secret-change-me

# ---------------------------------------------------------------- email (OTP, verification, reset)
# Unset -> codes are printed to the server console and shown in the UI. Development only.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=DepLens <noreply@yourdomain.dev>

# ---------------------------------------------------------------- deployment
# Public origin, used for links in e-mails and for the CSRF origin check.
NEXT_PUBLIC_APP_URL=http://localhost:3111

# ---------------------------------------------------------------- tests only
# Makes /api/captcha return the challenge answer so the e2e script can submit forms.
# Ignored whenever NODE_ENV=production, so a deployed instance can never do this.
# DEPLENS_E2E=1
